# Copy to .env.development.local for RSVP development only.
# Do NOT put VITE_RSVP_ENABLED=true in .env.local — that also loads during `vite build`
# and could ship RSVP into a production bundle. Live wedding build stays flag-off.

VITE_RSVP_ENABLED=false
# Leave empty to use Vite proxy → localhost:8787
VITE_RSVP_API_BASE=
VITE_RSVP_ADMIN_TOKEN=change-me-to-a-long-secret
